{
  "name": "it-asset-management",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node -O '{\"module\":\"commonjs\"}' prisma/seed.ts",
    "test:e2e": "node test-e2e.mjs",
    "test:phase2": "node test-phase2.mjs",
    "test:print": "node test-print-layout.mjs",
    "test:photos": "node test-photos.mjs",
    "test:drawer": "node test-drawer-presentation.mjs",
    "test:security": "ts-node -O '{\"module\":\"commonjs\"}' test-supabase-security.ts",
    "test:users": "ts-node -O '{\"module\":\"commonjs\"}' test-user-management.ts",
    "test:all": "node test-e2e.mjs && node test-phase2.mjs && node test-print-layout.mjs && node test-photos.mjs && node test-drawer-presentation.mjs && npm run test:security && npm run test:users"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.119.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
