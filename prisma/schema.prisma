datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  IT_ADMIN
  FINANCE
  AUDITOR
  EMPLOYEE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(IT_ADMIN)
  companyId    String?
  company      Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  employeeId   String?   @unique
  employee     Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@map("users")
}

model Company {
  id          String   @id @default(cuid())
  code        String   @unique // "GMD", "GMC", "TEL"
  name        String   // "GMD", "GMC", "TEL"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets              Asset[]
  employees           Employee[]
  users               User[]
  stockOpnameSessions StockOpnameSession[]

  @@map("companies")
}

model Employee {
  id           String    @id @default(cuid())
  employeeId   String    @unique // e.g., "EMP-00104"
  name         String
  email        String?   @unique
  department   String?
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE, RESIGNED
  user         User?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedAssets Asset[]
  assignments    AssetAssignment[]

  @@index([companyId])
  @@map("employees")
}

enum AssetStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DISPOSED
  ARCHIVED
  MISSING
}

enum PhysicalCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  DAMAGED
}

enum AssetCategory {
  LAPTOP
  DESKTOP
  SERVER
  MONITOR
  PRINTER
  NETWORK_EQUIPMENT
  ACCESSORY
  OTHER
}

enum AssignmentAction {
  ASSIGN
  RETURN
  TRANSFER
  REPLACEMENT
}

enum DepreciationMethod {
  STRAIGHT_LINE
  REDUCING_BALANCE
  NONE
}

enum OpnameStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  MISMATCH_LOCATION
  MISMATCH_USER
  MISSING
  UNREGISTERED
}

enum PhotoCategory {
  MAIN_PHOTO
  FRONT_VIEW
  BACK_BOTTOM_VIEW
  SERIAL_NUMBER
  DAMAGE_CONDITION
  HANDOVER
  RETURN
  OTHER
}

model Asset {
  // Immutable primary key
  id                     String             @id @default(cuid())

  // Legacy / Corporate Asset Tag (preserved verbatim, duplicate values supported)
  assetTag               String
  isDuplicateTag         Boolean            @default(false)

  assetName              String
  companyId              String
  company                Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category               AssetCategory      @default(LAPTOP)
  model                  String
  cpu                    String
  ram                    String

  // Optional Serial Number
  serialNumber           String?
  macAddress             String?
  status                 AssetStatus        @default(AVAILABLE)
  physicalCondition      PhysicalCondition  @default(GOOD)

  assignedEmployeeId     String?
  assignedEmployee       Employee?          @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  location               String
  purchaseDate           DateTime?

  // Financial schema (restricted to Super Admin & Finance)
  purchaseCost           Decimal?           @db.Decimal(12, 2)
  usefulLifeMonths       Int?
  depreciationMethod     DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciation Decimal?          @default(0) @db.Decimal(12, 2)
  netBookValue           Decimal?           @db.Decimal(12, 2)
  depreciationStartDate  DateTime?

  // Non-sensitive machine identifiers (Zero Passwords)
  laptopCode             String?
  laptopAccount          String?
  username               String?
  notes                  String?            @db.Text

  // QR & Stock Opname ready
  qrCodeToken            String?            @unique

  isArchived             Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  assignments            AssetAssignment[]
  historyLogs            AssetHistory[]
  stockOpnameItems       StockOpnameItem[]
  photos                 AssetPhoto[]

  @@index([companyId])
  @@index([assetTag])
  @@index([serialNumber])
  @@index([status])
  @@index([category])
  @@index([assignedEmployeeId])
  @@map("assets")
}

model AssetAssignment {
  id                String            @id @default(cuid())
  assetId           String
  asset             Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          Employee?         @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  actionType        AssignmentAction
  conditionAtAction PhysicalCondition @default(GOOD)
  assignedAt        DateTime          @default(now())
  returnedAt        DateTime?
  performedBy       String?
  handoverDocRef    String?
  notes             String?           @db.Text

  photos            AssetPhoto[]

  @@index([assetId])
  @@index([employeeId])
  @@map("asset_assignments")
}

model AssetPhoto {
  id               String            @id @default(cuid())
  assetId          String
  asset            Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category         PhotoCategory     @default(MAIN_PHOTO)
  fileKey          String            @unique
  thumbnailKey     String?
  originalFilename String
  mimeType         String
  fileSize         Int
  width            Int?
  height           Int?
  description      String?           @db.Text
  isPrimary        Boolean           @default(false)
  assignmentId     String?
  assignment       AssetAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  uploadedBy       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([assetId])
  @@index([category])
  @@index([isPrimary])
  @@index([assignmentId])
  @@map("asset_photos")
}

model AssetHistory {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action      String   // CREATED, UPDATED, TRANSFERRED, ARCHIVED, MAINTENANCE, REASSIGNED
  changes     Json?    // Field diff
  notes       String?  @db.Text
  performedBy String?
  createdAt   DateTime @default(now())

  @@index([assetId])
  @@map("asset_histories")
}

model StockOpnameSession {
  id             String              @id @default(cuid())
  sessionNumber  String              @unique
  title          String
  companyId      String?
  company        Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  locationScope  String?             @default("ALL")
  categoryScope  String?             @default("ALL")
  status         OpnameStatus        @default(IN_PROGRESS)
  startDate      DateTime            @default(now())
  endDate        DateTime?
  conductedBy    String?
  reconciledAt   DateTime?
  reconciledBy   String?
  notes          String?             @db.Text
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          StockOpnameItem[]

  @@index([companyId])
  @@index([status])
  @@map("stock_opname_sessions")
}

model StockOpnameItem {
  id                 String             @id @default(cuid())
  sessionId          String
  session            StockOpnameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assetId            String
  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  // Expected snapshot captured at audit initialization
  expectedLocation   String?
  expectedEmployeeId String?
  expectedCondition  PhysicalCondition?

  // Actual scanned audit data
  scannedAt          DateTime?
  scannedBy          String?
  verificationStatus VerificationStatus @default(PENDING)
  actualLocation     String?
  actualCondition    PhysicalCondition?
  actualEmployeeId   String?

  // Discrepancy & duplicate detection
  isUnexpected       Boolean            @default(false)
  scanCount          Int                @default(0)
  discrepancyNotes   String?            @db.Text
  reconciled         Boolean            @default(false)

  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([sessionId, assetId])
  @@index([sessionId])
  @@index([assetId])
  @@index([verificationStatus])
  @@map("stock_opname_items")
}

